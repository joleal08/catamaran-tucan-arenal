# ============================================================================
# CATAMARÁN TUCÁN ARENAL - CONFIGURACIÓN DE ENTORNO (.env.example)
# ============================================================================

# 1. MODO DEMO / MOCK (Actívalo en 'true' para pruebas sin credenciales reales de Tilopay ni Supabase)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. SUPABASE (Opcional en Modo Demo - Requerido en Producción)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. PASARELA DE PAGO TILOPAY COSTA RICA (Opcional en Modo Demo - Requerido en Producción)
TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_WEBHOOK_SECRET=

# 4. NOTIFICACIONES AUTOMÁTICAS VOUCHER QR (Opcional)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=
RESEND_API_KEY=
